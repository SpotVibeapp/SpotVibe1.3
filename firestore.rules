rules_version = '2';

// SpotVibe — Firestore security rules.
// Deploy:  firebase deploy --only firestore:rules
//
// Data model:
//   users/{uid}                      public profile
//   users/{uid}/saved_events/{id}    bookmarks / interested
//   events/{eventId}                 curated + user-created feed
//   events/{eventId}/rsvps/{userId}
//   events/{eventId}/comments/{id}
//   user_events/{id}                 creator extras (mirrors events/)
//   user_reports/{id}
//   meta/event_seed                  El Paso seed version

service cloud.firestore {
  match /databases/{database}/documents {

    match /users/{uid} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
                    && request.auth.uid == uid
                    && request.resource.data.keys().hasAll(['name', 'email', 'avatarUrl'])
                    && request.resource.data.name is string
                    && request.resource.data.name.size() <= 100;
      allow update: if request.auth != null && request.auth.uid == uid;
      allow delete: if false;

      match /saved_events/{eventId} {
        allow read, write: if request.auth != null
                           && request.auth.uid == uid;
      }
    }

    // Public feed. Anyone can read (discovery). Writes are open enough
    // for the client-side El Paso seed and RSVP count increments.
    // Tighten before a public launch.
    match /events/{eventId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if request.auth != null
                    && resource.data.creatorId == request.auth.uid;

      match /rsvps/{userId} {
        allow read: if true;
        allow create, update, delete: if request.auth != null
                                      && request.auth.uid == userId;
      }

      match /comments/{commentId} {
        allow read: if true;
        allow create: if request.auth != null
                      && request.resource.data.authorId == request.auth.uid
                      && request.resource.data.text is string
                      && request.resource.data.text.size() <= 2000;
        allow update, delete: if request.auth != null
                              && resource.data.authorId == request.auth.uid;
      }
    }

    match /user_events/{eventId} {
      allow read: if true;
      allow create: if request.auth != null
                    && request.resource.data.creatorId == request.auth.uid;
      allow update, delete: if request.auth != null
                            && resource.data.creatorId == request.auth.uid;
    }

    match /meta/{docId} {
      allow read: if true;
      allow write: if true; // client seed version stamp
    }

    match /user_reports/{reportId} {
      allow create: if request.auth != null
                    && request.resource.data.reportedUserId is string
                    && request.resource.data.reason is string
                    && request.resource.data.reason.size() <= 1000;
      allow read, update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
