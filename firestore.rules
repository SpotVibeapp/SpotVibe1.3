rules_version = '2';

// SpotVibe — Firestore security rules for Firebase Auth.
// Deploy:  firebase deploy --only firestore:rules
//
// Data model:
//   users/{uid}         public profile (name, email, avatarUrl, provider)
//   user_reports/{id}   misconduct reports written by signed-in users

service cloud.firestore {
  match /databases/{database}/documents {

    // ── User profiles ───────────────────────────────────────────────────────
    // Everyone signed in can read any profile (attendee lists, comments).
    // A user may create/update only their own document; the uid in the path
    // must match their auth uid. Deletes are not allowed from clients.
    match /users/{uid} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
                    && request.auth.uid == uid
                    // Only known profile fields may be written.
                    && request.resource.data.keys().hasAll(['name', 'email', 'avatarUrl'])
                    && request.resource.data.name is string
                    && request.resource.data.name.size() <= 100;
      allow update: if request.auth != null && request.auth.uid == uid;
      allow delete: if false;
    }

    // ── User reports ────────────────────────────────────────────────────────
    // Signed-in users can file reports; only server-side admins read them
    // (no client reads).
    match /user_reports/{reportId} {
      allow create: if request.auth != null
                    && request.resource.data.reportedUserId is string
                    && request.resource.data.reason is string
                    && request.resource.data.reason.size() <= 1000;
      allow read, update, delete: if false;
    }

    // Everything else: locked down by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
