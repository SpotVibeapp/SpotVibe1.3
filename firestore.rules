rules_version = '2';

// SpotVibe — Firestore security rules.
// Deploy:  firebase deploy --only firestore:rules
//
// Data model:
//   users/{uid}                      public profile (name, avatar — no PII)
//   users/{uid}/private/profile      owner-only: email / phone
//   users/{uid}/saved_events/{id}    bookmarks / interested
//   blocks/{uid}/blocked/{target}    per-user block list
//   events/{eventId}                 curated + user-created feed
//   events/{eventId}/rsvps/{userId}
//   events/{eventId}/comments/{id}
//   user_events/{id}                 creator extras (mirrors events/)
//   event_claims/{id}
//   user_reports/{id}
//   partner_promo_codes/{id}         admin-only store-code inventory
//   meta/event_seed, meta/founding   read-only; written by Cloud Functions
//   featured_weeks/{uid_week}        Cloud Functions only (weekly feature)
//
// Notes:
//  - The public feed is readable by everyone (including guests) for discovery.
//  - Writes to the public feed require an authenticated creator.
//  - Counters are the only fields other users may change on someone else's
//    event doc: analytics counters by exactly +1 (one per write), and
//    bookmark/interested counts by ±1 tied to the caller's own saved_events
//    flag flipping in the same transaction.
//  - featuredWeekKey (paid perk) is set only by the featureEvent function.
//  - Curated El Paso seed data is written by the `seedCuratedEvents` Cloud
//    Function (Admin SDK), not by clients.

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }
    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }
    // Admins are listed in the `admins/{uid}` collection (created via the
    // Firebase console or the `promoteAdmin` Cloud Function — never by clients).
    function isAdmin() {
      return isSignedIn()
             && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // The primary cover is included in imageUrls. Legacy documents without
    // gallery fields remain valid, while new writes are capped at five photos
    // and three short videos per event.
    function hasValidEventMedia(data) {
      return (!data.keys().hasAll(['imageUrls'])
                || (data.imageUrls is list && data.imageUrls.size() <= 5))
          && (!data.keys().hasAll(['videoUrls'])
                || (data.videoUrls is list && data.videoUrls.size() <= 3));
    }

    // New event windows must carry both an explicit start and end. Existing
    // legacy events remain readable and can still receive analytics updates;
    // changing their timing requires adding a valid end time.
    function hasValidEventTiming(data) {
      return data.keys().hasAll(['dateTimeMs', 'endDateTimeMs'])
          && data.dateTimeMs is int
          && data.endDateTimeMs is int
          && data.endDateTimeMs > data.dateTimeMs;
    }
    function keepsValidEventTiming(data, existing) {
      return !data.diff(existing).affectedKeys().hasAny([
               'dateTime',
               'dateTimeMs',
               'endDateTime',
               'endDateTimeMs'
             ])
          || hasValidEventTiming(data);
    }

    // Public organizer social links are optional and limited to the known
    // platform keys. The app additionally canonicalizes each value to an
    // official HTTPS platform URL before rendering or launching it.
    function isValidSocialLinkValue(value) {
      return value is string
          && value.size() <= 512
          && value.matches('https://.*');
    }
    function hasValidSocialLinks(data) {
      return !data.keys().hasAll(['socialLinks'])
          || (data.socialLinks is map
              && data.socialLinks.keys().hasOnly([
                'instagram', 'facebook', 'snapchat', 'tiktok', 'youtube'
              ])
              && data.socialLinks.size() <= 5
              && (!data.socialLinks.keys().hasAny(['instagram'])
                  || isValidSocialLinkValue(data.socialLinks.instagram))
              && (!data.socialLinks.keys().hasAny(['facebook'])
                  || isValidSocialLinkValue(data.socialLinks.facebook))
              && (!data.socialLinks.keys().hasAny(['snapchat'])
                  || isValidSocialLinkValue(data.socialLinks.snapchat))
              && (!data.socialLinks.keys().hasAny(['tiktok'])
                  || isValidSocialLinkValue(data.socialLinks.tiktok))
              && (!data.socialLinks.keys().hasAny(['youtube'])
                  || isValidSocialLinkValue(data.socialLinks.youtube)));
    }

    // ── Server-managed event fields ─────────────────────────────────────────
    // `featuredWeekKey` is a paid Premium perk: only the `featureEvent` Cloud
    // Function (after a RevenueCat check) or an admin may set it. Ingestion /
    // archive bookkeeping fields are written by Cloud Functions only.
    // featuredWeekKey is checked separately (it may be sent as null: the
    // live v14 build always includes the key, null for non-featured events).
    function serverManagedEventKeys() {
      return ['featuredAt', 'ingestedAt', 'ingestSource', 'archivedAt'];
    }
    function doesNotSetFeaturedWeek() {
      return !changedKeys().hasAny(['featuredWeekKey'])
          || request.resource.data.get('featuredWeekKey', null) == null;
    }
    // Feed sort key: when present it must equal the end time (or the start
    // for legacy docs without an end), so nobody can pin a listing in the
    // feed past its real end.
    function hasValidFeedKey(data) {
      return !('visibleUntilMs' in data)
          || data.visibleUntilMs == data.get('endDateTimeMs', null)
          || (data.get('endDateTimeMs', null) == null
              && data.visibleUntilMs == data.get('dateTimeMs', null));
    }
    function analyticsKeys() {
      return ['analyticsSearchImpressions', 'analyticsViews',
              'analyticsSaves', 'analyticsClicks'];
    }
    function saveCounterKeys() {
      return ['bookmarkedCount', 'interestedCount'];
    }
    function changedKeys() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }
    // New docs: no paid perk, counters start at zero (or are absent).
    function startsWithoutPerksOrCounts(data) {
      return (!('featuredWeekKey' in data) || data.featuredWeekKey == null)
          && (!('analyticsSearchImpressions' in data) || data.analyticsSearchImpressions == 0)
          && (!('analyticsViews' in data) || data.analyticsViews == 0)
          && (!('analyticsSaves' in data) || data.analyticsSaves == 0)
          && (!('analyticsClicks' in data) || data.analyticsClicks == 0)
          && (!('bookmarkedCount' in data) || data.bookmarkedCount == 0)
          && (!('interestedCount' in data) || data.interestedCount == 0);
    }
    function bumpedByOne(field) {
      return request.resource.data[field] is int
          && request.resource.data[field] == resource.data.get(field, 0) + 1;
    }
    // Exactly one analytics counter changes, by exactly +1.
    function isSingleAnalyticsBump() {
      return changedKeys().size() == 1
          && ((changedKeys().hasOnly(['analyticsSearchImpressions']) && bumpedByOne('analyticsSearchImpressions'))
              || (changedKeys().hasOnly(['analyticsViews']) && bumpedByOne('analyticsViews'))
              || (changedKeys().hasOnly(['analyticsSaves']) && bumpedByOne('analyticsSaves'))
              || (changedKeys().hasOnly(['analyticsClicks']) && bumpedByOne('analyticsClicks')));
    }
    // bookmarkedCount / interestedCount move by ±1 only together with the
    // caller's own saved_events/{eventId} flag flipping in the same
    // transaction (this is exactly what the app — including the live v14
    // build — writes).
    function savedFlag(eventId, flag, afterWrite) {
      let path = /databases/$(database)/documents/users/$(request.auth.uid)/saved_events/$(eventId);
      return afterWrite
          ? (existsAfter(path) && getAfter(path).data.get(flag, false) == true)
          : (exists(path) && get(path).data.get(flag, false) == true);
    }
    function saveCounterMatchesFlag(eventId, field, flag) {
      let before = savedFlag(eventId, flag, false) ? 1 : 0;
      let after = savedFlag(eventId, flag, true) ? 1 : 0;
      return after != before
          && request.resource.data[field] is int
          && request.resource.data[field] == resource.data.get(field, 0) + (after - before);
    }
    function isSaveCounterUpdate(eventId) {
      return changedKeys().size() > 0
          && changedKeys().hasOnly(saveCounterKeys())
          && (!changedKeys().hasAny(['bookmarkedCount'])
              || saveCounterMatchesFlag(eventId, 'bookmarkedCount', 'bookmarked'))
          && (!changedKeys().hasAny(['interestedCount'])
              || saveCounterMatchesFlag(eventId, 'interestedCount', 'interested'));
    }
    // The creator may edit their listing, but not paid/server fields or the
    // public counters.
    function isCreatorContentEdit() {
      return isSignedIn()
          && resource.data.creatorId == request.auth.uid
          && !changedKeys().hasAny(serverManagedEventKeys())
          && doesNotSetFeaturedWeek()
          && !changedKeys().hasAny(analyticsKeys())
          && !changedKeys().hasAny(saveCounterKeys())
          && request.resource.data.creatorId == resource.data.creatorId;
    }

    // ── Admin roster (read by the admin themself; write only via console /
    //    Admin SDK / Cloud Functions) ──────────────────────────────────────
    match /admins/{uid} {
      allow read: if isOwner(uid);
      allow write: if false;
    }

    // ── User profiles ─────────────────────────────────────────────────────
    // The public doc is readable by every signed-in user, so it must never
    // hold contact details. Email/phone live in users/{uid}/private/profile.
    // A private key may appear on the public doc only as '' (the client
    // writes `email: ''` on create so that profile creation also works with
    // the previous rules during rollout). Legacy values may be deleted, never
    // set or changed.
    function blankIfPresent(data, key) {
      return !(key in data) || data[key] == '';
    }
    function publicDocHasNoPii(data) {
      return blankIfPresent(data, 'email')
          && blankIfPresent(data, 'phone')
          && blankIfPresent(data, 'phoneNumber');
    }
    // On update: each private key is either removed, blank, or left exactly
    // as it was (so a not-yet-migrated legacy doc can still update its name
    // or avatar).
    function keepsOrRemovesPrivateKey(key) {
      return !(key in request.resource.data)
          || request.resource.data[key] == ''
          || (key in resource.data
              && request.resource.data[key] == resource.data[key]);
    }

    match /users/{uid} {
      allow read: if isSignedIn();
      allow create: if isOwner(uid)
                    && request.resource.data.keys().hasAll(['name', 'avatarUrl'])
                    && request.resource.data.name is string
                    && request.resource.data.name.size() <= 100
                    && publicDocHasNoPii(request.resource.data);
      allow update: if isOwner(uid)
                    && keepsOrRemovesPrivateKey('email')
                    && keepsOrRemovesPrivateKey('phone')
                    && keepsOrRemovesPrivateKey('phoneNumber')
                    && (!('name' in request.resource.data)
                        || (request.resource.data.name is string
                            && request.resource.data.name.size() <= 100));
      allow delete: if isOwner(uid);

      // Owner-only contact details (and admins, for support/moderation).
      match /private/{docId} {
        allow read: if isOwner(uid) || isAdmin();
        allow create, update: if (isOwner(uid) || isAdmin())
                              && docId == 'profile'
                              && request.resource.data.keys().hasOnly([
                                   'email', 'phone', 'phoneNumber',
                                   'updatedAt', 'migratedAt'
                                 ])
                              && (!('email' in request.resource.data)
                                  || (request.resource.data.email is string
                                      && request.resource.data.email.size() <= 320));
        allow delete: if isOwner(uid) || isAdmin();
      }

      match /saved_events/{eventId} {
        allow read, write: if isOwner(uid);
      }
    }

    // ── Partner store-code inventory ───────────────────────────────────────
    // Codes are generated by App Store Connect / Google Play Console, then
    // stocked and issued only by admins. Regular users must never be able to
    // enumerate or redeem an app-created Premium-unlock code.
    match /partner_promo_codes/{codeId} {
      allow read, write: if isAdmin();
    }

    // ── Bans (doc ids = banned UIDs; readable by all so clients can hide
    //    banned users' content; written only by admins) ────────────────────
    match /bans/{uid} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ── Blocks ────────────────────────────────────────────────────────────
    match /blocks/{uid} {
      allow read: if isOwner(uid);
      match /blocked/{blockedUid} {
        allow read, write: if isOwner(uid);
      }
    }

    // ── Public feed ───────────────────────────────────────────────────────
    match /events/{eventId} {
      allow read: if true;
      allow create: if isSignedIn()
                    && request.resource.data.creatorId == request.auth.uid
                    && request.resource.data.title is string
                    && request.resource.data.title.size() <= 120
                    && hasValidEventMedia(request.resource.data)
                    && hasValidSocialLinks(request.resource.data)
                    && hasValidEventTiming(request.resource.data)
                    && startsWithoutPerksOrCounts(request.resource.data)
                    && !request.resource.data.keys().hasAny(serverManagedEventKeys())
                    && hasValidFeedKey(request.resource.data);
      allow update: if hasValidEventMedia(request.resource.data)
                    && hasValidSocialLinks(request.resource.data)
                    && keepsValidEventTiming(request.resource.data, resource.data)
                    && (isAdmin()
                        || (isCreatorContentEdit()
                            && hasValidFeedKey(request.resource.data))
                        || (isSignedIn() && isSingleAnalyticsBump())
                        || (isSignedIn() && isSaveCounterUpdate(eventId)));
      allow delete: if isAdmin()
                    || (isSignedIn()
                        && resource.data.creatorId == request.auth.uid);

      match /rsvps/{userId} {
        allow read: if true;
        allow create, update, delete: if isOwner(userId) || isAdmin();
      }

      match /comments/{commentId} {
        allow read: if true;
        allow create: if isSignedIn()
                      && request.resource.data.authorId == request.auth.uid
                      && request.resource.data.text is string
                      && request.resource.data.text.size() <= 2000;
        allow update, delete: if isAdmin()
                              || (isSignedIn()
                                  && resource.data.authorId == request.auth.uid);
      }
    }

    // ── Community hidden gems (user-generated, free) ───────────────────────
    match /gems/{gemId} {
      allow read: if true;
      allow create: if isSignedIn()
                    && request.resource.data.creatorId == request.auth.uid
                    && request.resource.data.name is string
                    && request.resource.data.name.size() > 0
                    && request.resource.data.name.size() <= 120
                    && request.resource.data.summary is string
                    && request.resource.data.summary.size() <= 200
                    && request.resource.data.latitude is number
                    && request.resource.data.longitude is number;
      // Owner/admin may edit; anyone signed in may bump the like/comment
      // counters (server-side Cloud Function also adjusts these).
      allow update: if isAdmin()
                    || (isSignedIn() && (
                      resource.data.creatorId == request.auth.uid
                      || request.resource.data.diff(resource.data).affectedKeys()
                          .hasOnly(['likeCount', 'commentCount'])
                    ));
      allow delete: if isAdmin()
                    || (isSignedIn()
                        && resource.data.creatorId == request.auth.uid);

      match /likes/{userId} {
        allow read: if true;
        allow create, delete: if isOwner(userId);
      }

      match /comments/{commentId} {
        allow read: if true;
        allow create: if isSignedIn()
                      && request.resource.data.authorId == request.auth.uid
                      && request.resource.data.text is string
                      && request.resource.data.text.size() <= 2000;
        allow update, delete: if isAdmin()
                              || (isSignedIn()
                                  && resource.data.authorId == request.auth.uid);
      }
    }

    // ── Creator event extras ──────────────────────────────────────────────
    match /user_events/{eventId} {
      allow read: if true;
      allow create: if hasValidEventMedia(request.resource.data)
                    && hasValidSocialLinks(request.resource.data)
                    && hasValidEventTiming(request.resource.data)
                    && (isAdmin()
                    || (isSignedIn()
                        && request.resource.data.creatorId == request.auth.uid
                        && request.resource.data.title is string
                        && request.resource.data.title.size() <= 120
                        && startsWithoutPerksOrCounts(request.resource.data)
                        && !request.resource.data.keys().hasAny(serverManagedEventKeys())));
      allow update: if hasValidEventMedia(request.resource.data)
                    && hasValidSocialLinks(request.resource.data)
                    && keepsValidEventTiming(request.resource.data, resource.data)
                    && (isAdmin()
                        || isCreatorContentEdit()
                        || (isSignedIn() && isSingleAnalyticsBump()));
      allow delete: if isAdmin()
                    || (isSignedIn()
                        && resource.data.creatorId == request.auth.uid);
    }

    // ── meta/* (incl. meta/founding) ──────────────────────────────────────
    // Read-only to clients. The founding roster is written only by the
    // `claimFoundingSlot` Cloud Function after a RevenueCat check.
    match /meta/{docId} {
      allow read: if true;
      allow write: if false; // Admin SDK / Cloud Functions only
    }

    // ── Venue claims ──────────────────────────────────────────────────────
    match /event_claims/{claimId} {
      allow read: if isAdmin()
                  || (isSignedIn()
                      && resource.data.userId == request.auth.uid);
      allow create: if isSignedIn()
                    && request.resource.data.userId == request.auth.uid
                    && request.resource.data.eventId is string
                    && request.resource.data.email is string
                    && request.resource.data.statement is string
                    && request.resource.data.statement.size() <= 2000
                    // Claimants may submit proof, but never self-approve or
                    // self-unlock a listing from the client.
                    && request.resource.data.status == 'pending'
                    && request.resource.data.unlocked == false
                    && request.resource.data.firstClaimFree == false;
      allow update: if isAdmin();
      allow delete: if isAdmin()
                    || (isSignedIn()
                        && resource.data.userId == request.auth.uid);
    }

    // ── User reports (write-only from clients; read/resolve by admins) ───
    match /user_reports/{reportId} {
      allow create: if isSignedIn()
                    && request.resource.data.reportedUserId is string
                    && request.resource.data.reason is string
                    && request.resource.data.reason.size() <= 1000;
      allow read, delete: if isAdmin();
      allow update: if false;
    }

    // ── Deny everything else ──────────────────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
