<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <application android:label="SpotVibe" android:name="${applicationName}" android:icon="@mipmap/launcher_icon">
        <activity android:name=".MainActivity" android:exported="true" android:launchMode="singleTop" android:taskAffinity="" android:theme="@style/LaunchTheme" android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode" android:hardwareAccelerated="true" android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data android:name="io.flutter.embedding.android.NormalTheme" android:resource="@style/NormalTheme"/>
            <!-- Deep links are handled by app_links (see lib/main.dart), so
                 Flutter's built-in handler must be OFF. Since Flutter 3.27 it
                 defaults to ON and pushes the raw intent URI
                 (spotvibe://event/<id>) straight into go_router, which has no
                 route for it -> "We could not open that page", overriding the
                 correct /event/<id> navigation app_links already performed. -->
            <meta-data android:name="flutter_deeplinking_enabled" android:value="false"/>
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
            <!-- PRIMIO_ADDED: deep_links — handle spotvibe.app/event/* and /user-event/* URLs -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data android:scheme="https" android:host="spotvibeapp.net" android:pathPattern="/event/.*"/>
            </intent-filter>
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data android:scheme="https" android:host="spotvibeapp.net" android:pathPattern="/user-event/.*"/>
            </intent-filter>
            <!-- Live Firebase Hosting domain (the current share-link base until
                 the spotvibeapp.net custom domain is connected). -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data android:scheme="https" android:host="spotvibe-cfa08.web.app" android:pathPattern="/event/.*"/>
            </intent-filter>
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data android:scheme="https" android:host="spotvibe-cfa08.web.app" android:pathPattern="/user-event/.*"/>
            </intent-filter>
            <!-- PRIMIO_ADDED: app_links — custom spotvibe:// scheme for app_links runtime URI delivery -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data android:scheme="spotvibe"/>
            </intent-filter>
        </activity>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data android:name="flutterEmbedding" android:value="2"/>
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
        <!-- Package visibility (Android 11+): without these declarations the
             app cannot see browsers / calendar / maps apps, so url_launcher
             and add_2_calendar silently fail with "could not open" errors. -->
        <!-- Browsers — ticket links, Google Calendar web fallback, web views -->
        <intent>
            <action android:name="android.intent.action.VIEW"/>
            <data android:scheme="https"/>
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW"/>
            <data android:scheme="http"/>
        </intent>
        <!-- Maps apps — geo: directions intents -->
        <intent>
            <action android:name="android.intent.action.VIEW"/>
            <data android:scheme="geo"/>
        </intent>
        <!-- Calendar apps — add_2_calendar event inserts -->
        <intent>
            <action android:name="android.intent.action.INSERT"/>
            <data android:mimeType="vnd.android.cursor.item/event"/>
        </intent>
        <!-- Email clients — organizer contact links -->
        <intent>
            <action android:name="android.intent.action.SENDTO"/>
            <data android:scheme="mailto"/>
        </intent>
    </queries>
    <uses-permission android:name="android.permission.INTERNET"/>
    <uses-permission android:name="android.permission.CAMERA"/>
    <uses-permission android:name="android.permission.RECORD_AUDIO"/>
    <!-- Media selection uses image_picker, which routes gallery access through
         the Android Photo Picker (no runtime permission required). Plugins
         (image_picker_android, permission_handler) declare the broad
         READ_MEDIA_* permissions in their own manifests, which merge into ours
         and trigger Google Play's Photo & Video Permissions policy review for
         access we do not need. Explicitly remove them from the merged manifest. -->
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES"
        tools:node="remove"/>
    <uses-permission android:name="android.permission.READ_MEDIA_VIDEO"
        tools:node="remove"/>
    <uses-permission android:name="android.permission.READ_MEDIA_VISUAL_USER_SELECTED"
        tools:node="remove"/>
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"
        tools:node="remove"/>
    <!-- The app does not use ads or an advertising ID. Plugins (e.g.
         awesome_notifications / Play Services pulled transitively) inject the
         AD_ID permission into the merged manifest; remove it so the app does
         not declare advertising-ID use to Google Play. -->
    <uses-permission android:name="com.google.android.gms.permission.AD_ID"
        tools:node="remove"/>
    <!-- Privacy Sandbox AdServices ad-id permission, injected by transitive
         Play Services libraries. The app has no ads, so remove it too. -->
    <uses-permission android:name="android.permission.ACCESS_ADSERVICES_AD_ID"
        tools:node="remove"/>
    <!-- PRIMIO_ADDED: permission_handler — location permission for nearby event discovery -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION"/>
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION"/>
    <!-- PRIMIO_ADDED: awesome_notifications — POST_NOTIFICATIONS required on Android 13+ -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <!-- Required for Google Play in-app subscriptions (purchases_flutter / Billing Library) -->
    <uses-permission android:name="com.android.vending.BILLING"/>
</manifest>
